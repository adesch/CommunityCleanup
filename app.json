{
  "expo": {
    "name": "Community Cleanup",
    "slug": "community-cleanup",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "communitycleanup",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.communitycleanup.app"
    },
    "android": {
      "package": "com.communitycleanup.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "372eb69a-33fc-45b6-b2a5-0441b969ebf6"
      }
    },
    "owner": "adesch18"
  }
}
