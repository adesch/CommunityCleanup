# Server-only. Never prefix this key with EXPO_PUBLIC_ and never commit a real value.
OPENAI_API_KEY=replace_with_a_project_api_key
OPENAI_MODEL=gpt-6-luna
AI_ENABLED=true

# Required by native builds when the API route is deployed separately.
# For web, the chatbot uses the same origin and this can remain blank.
EXPO_PUBLIC_API_URL=
